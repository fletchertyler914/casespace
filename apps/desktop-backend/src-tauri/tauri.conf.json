{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "desktop-backend",
  "version": "0.1.2",
  "identifier": "com.casespace.desktop-backend",
  "build": {
    "beforeDevCommand": "pnpm --filter desktop dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm --filter desktop build",
    "frontendDist": "../../desktop/out"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "desktop-backend",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
