{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CaseSpace",
  "version": "0.1.8",
  "identifier": "com.casespace.desktop",
  "build": {
    "beforeDevCommand": "pnpm --filter desktop dev:next",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm --filter desktop build",
    "frontendDist": "../../desktop/out"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "CaseSpace",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [
        "https://example.com/casespace/releases/{{target}}/{{arch}}/{{current_version}}"
      ]
    }
  }
}
