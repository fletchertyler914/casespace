{
  "name": "casespace",
  "private": true,
  "license": "BUSL-1.1",
  "scripts": {
    "build": "turbo run build --filter=!desktop-backend && pnpm --filter desktop-backend build",
    "dev": "pnpm --filter desktop-backend dev",
    "dev:desktop": "pnpm --filter desktop-backend dev",
    "dev:ui": "pnpm --filter desktop dev:next",
    "dev:web": "pnpm --filter web dev",
    "dev:all": "turbo run dev --filter=web --filter=desktop-backend --filter=@repo/ui",
    "lint": "turbo run lint --filter=!desktop-backend",
    "check-types": "turbo run check-types --filter=!desktop-backend",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "arch:check": "node ./scripts/enforce-architecture.mjs",
    "codegen:report-templates": "node ./scripts/codegen-report-templates.mjs",
    "release:verify-links": "node ./scripts/verify-release-links.mjs",
    "release:status": "node ./scripts/release-automation.mjs status",
    "release:validate": "node ./scripts/release-automation.mjs validate",
    "test:desktop": "pnpm --filter desktop test",
    "test:e2e": "pnpm --filter desktop test:e2e",
    "ops:validate:local": "pnpm arch:check && pnpm lint && pnpm check-types && pnpm test:parity && pnpm test:hardening && pnpm test:desktop && pnpm test:e2e && pnpm build && node ./scripts/validate-unified-release-system.mjs",
    "ops:validate:remote": "pnpm release:status",
    "ops:validate:prod": "pnpm release:validate",
    "ops:validate": "pnpm ops:validate:local && pnpm ops:validate:remote",
    "test:parity": "cargo test --manifest-path apps/desktop-backend/src-tauri/Cargo.toml",
    "test:hardening": "cargo test --manifest-path apps/desktop-backend/src-tauri/Cargo.toml --test hardening_pass"
  },
  "devDependencies": {
    "@types/culori": "^4.0.1",
    "culori": "^4.0.2",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.7.4",
    "sharp": "^0.34.5",
    "turbo": "^2.9.14"
  },
  "pnpm": {
    "minimumReleaseAge": 2880
  },
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=24.0.0"
  }
}
