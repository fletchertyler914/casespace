{
  "name": "with-tailwind",
  "private": true,
  "scripts": {
    "build": "turbo run build --filter=!desktop-backend && pnpm --filter desktop-backend build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "check-types": "turbo run check-types",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "arch:check": "node ./scripts/enforce-architecture.mjs",
    "release:verify-links": "node ./scripts/verify-release-links.mjs"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "turbo": "^2.7.4"
  },
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=18"
  }
}
